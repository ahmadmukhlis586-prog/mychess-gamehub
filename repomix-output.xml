  border-top-color:
    #ffffff;

  border-radius: 50%;

  animation:
    mychess-spin
    0.7s
    linear
    infinite;
}

@keyframes mychess-spin {
  to {
    transform:
      rotate(360deg);
  }
}


/* =========================================================
   AUTH FOOTER
   ========================================================= */

.mychess-auth-footer {
  margin-top: 24px;

  text-align: center;

  font-size: 11px;

  color:
    rgba(255,255,255,0.28);
}


.mychess-auth-footer button {
  border: 0;

  padding: 0;

  margin-left: 5px;

  color:
    #a78bfa;

  background: transparent;

  font-size: 11px;

  font-weight: 700;
}


.mychess-auth-footer button:hover {
  color: #c4b5fd;
}


/* =========================================================
   SECURITY NOTE
   ========================================================= */

.mychess-security-note {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 6px;

  margin-top: 18px;

  font-size: 9px;

  color:
    rgba(255,255,255,0.19);
}


.mychess-security-note span {
  font-size: 10px;
}


/* =========================================================
   AUTHENTICATED TEMPORARY SCREEN
   ========================================================= */

