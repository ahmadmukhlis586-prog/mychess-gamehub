  |--------------------------------------------------------------------------
  | CHAT
  |--------------------------------------------------------------------------
  */

  function sendChat(event) {
    event.preventDefault();

    const text =
      chatInput.trim();

    if (!text) return;

    if (!socketRef.current) {
      return;
