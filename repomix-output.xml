}


.mychess-field input:disabled {
  opacity: 0.55;
}


.mychess-field small {
  margin-top: 6px;

  font-size: 10px;

  line-height: 1.4;

  color:
    rgba(255,255,255,0.25);
}


/* =========================================================
   MESSAGE
   ========================================================= */

.mychess-message {
  padding:
    11px
    13px;

  border-radius: 10px;

  font-size: 11px;

  line-height: 1.5;
}


.mychess-message.error {
  color:
    #ffb4c0;

  border:
    1px solid
    rgba(244,63,94,0.20);

  background:
    rgba(244,63,94,0.07);
}


.mychess-message.success {
  color:
    #c4b5fd;

  border:
    1px solid
    rgba(139,92,246,0.22);

  background:
    rgba(139,92,246,0.08);
}


/* =========================================================
   PRIMARY BUTTON
   ========================================================= */

.mychess-primary-button {
  width: 100%;

  min-height: 51px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  margin-top: 2px;

  border: 0;

  border-radius: 11px;

  color: #ffffff;

  background:
    linear-gradient(
      110deg,
      #7c3aed,
      #6d28d9
    );

  font-size: 12px;

  font-weight: 800;

  box-shadow:
    0 12px 30px
    rgba(109,40,217,0.22),

    inset 0 1px 0
    rgba(255,255,255,0.16);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    filter 0.2s ease;
}


.mychess-primary-button:hover:not(:disabled) {
  transform:
    translateY(-1px);

  filter:
    brightness(1.08);

  box-shadow:
    0 16px 38px
    rgba(109,40,217,0.32);
}


.mychess-primary-button:active:not(:disabled) {
  transform:
    translateY(0);
}


.mychess-primary-button span {
