      setCreatedRoom(room);

      localStorage.setItem(
        ROOM_KEY,
        room
      );

      /*
       * IMPORTANT:
       * Immediately enter the realtime
       * multiplayer room instead of leaving
       * the user stuck inside the modal.
       */

      setLobbyMode(null);
      setLobbyMessage('');
      setLobbyMessageType('');

      connectToMatch(room);
    } catch (error) {
      setLobbyMessage(
        error.message ||
          'Unable to create lobby.'
      );
      setLobbyMessageType('error');
    } finally {
      setLobbyLoading(false);
