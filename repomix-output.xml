<file path="client/src/App.css">
* {
  box-sizing: border-box;
}

:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #ffffff;
  background: #08070d;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: #08070d;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
}


/* =========================================================
   AUTH PAGE
   ========================================================= */

.mychess-auth-page {
  position: relative;

  min-height: 100vh;
  width: 100%;

  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 32px;

  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(122, 72, 255, 0.18),
      transparent 34%
    ),
    radial-gradient(
      circle at 85% 80%,
      rgba(91, 42, 177, 0.13),
      transparent 35%
    ),
    linear-gradient(
      135deg,
      #050509 0%,
      #0b0911 50%,
      #09070d 100%
    );
}


/* =========================================================
   BACKGROUND GRID
   ========================================================= */

.mychess-background-grid {
  position: absolute;
  inset: -50%;

  pointer-events: none;

  opacity: 0.20;

  background-image:
    linear-gradient(
      rgba(255,255,255,0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255,255,255,0.025) 1px,
      transparent 1px
    );

  background-size: 56px 56px;

  transform:
    perspective(700px)
    rotateX(55deg)
    translateY(10%);

  animation:
    mychess-grid-move
    18s
    linear
    infinite;
}

@keyframes mychess-grid-move {
  from {
    transform:
      perspective(700px)
      rotateX(55deg)
      translateY(0);
  }

  to {
    transform:
      perspective(700px)
      rotateX(55deg)
      translateY(56px);
  }
}


/* =========================================================
   GLOW
   ========================================================= */

.mychess-glow {
  position: absolute;

  width: 420px;
  height: 420px;

  border-radius: 50%;

  filter: blur(90px);

  opacity: 0.16;

  pointer-events: none;
}

.glow-one {
  top: -180px;
  left: -120px;

  background: #6f35d9;
}

.glow-two {
  right: -160px;
  bottom: -180px;

  background: #9b57ff;
}


/* =========================================================
   MAIN CONTAINER
   ========================================================= */

.mychess-auth-container {
  position: relative;
  z-index: 2;

  width: min(
    1120px,
    100%
  );

  min-height: 680px;

  display: grid;

  grid-template-columns:
    1.05fr
    0.95fr;

  overflow: hidden;

  border:
    1px solid
    rgba(255,255,255,0.09);

  border-radius: 28px;

  background:
    rgba(12, 10, 18, 0.86);

  box-shadow:
    0 30px 100px
    rgba(0,0,0,0.58),

    inset 0 1px 0
    rgba(255,255,255,0.04);

  backdrop-filter:
    blur(24px);
}


/* =========================================================
   BRAND PANEL
   ========================================================= */

.mychess-brand-panel {
  position: relative;

  display: flex;
  flex-direction: column;

  padding: 58px;

  background:
    linear-gradient(
      145deg,
      rgba(111,53,217,0.17),
      rgba(10,9,14,0.1) 45%,
      rgba(0,0,0,0.20)
    );

  border-right:
    1px solid
    rgba(255,255,255,0.07);
}


.mychess-brand-top {
  display: flex;
  align-items: center;

  gap: 15px;
}


.mychess-logo-mark {
  width: 48px;
  height: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 14px;

  color: #ffffff;

  font-size: 26px;

  background:
    linear-gradient(
      145deg,
      #8b5cf6,
      #4c1d95
    );

  box-shadow:
    0 10px 35px
    rgba(124,58,237,0.35),

    inset 0 1px 0
    rgba(255,255,255,0.25);
}


.mychess-brand {
  font-size: 19px;

  font-weight: 800;

  letter-spacing: 0.18em;

  color: #ffffff;
}


.mychess-brand-subtitle {
  margin-top: 3px;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 0.27em;

  color:
    rgba(255,255,255,0.38);
}


.mychess-brand-content {
  margin-top: auto;
  margin-bottom: auto;

  max-width: 500px;
}


.mychess-eyebrow {
  margin-bottom: 20px;

  font-size: 11px;

  font-weight: 700;

  letter-spacing: 0.22em;

  color:
    rgba(190,160,255,0.78);
}


.mychess-brand-content h1 {
  margin: 0;

  font-size:
    clamp(
      42px,
      5vw,
      70px
    );

  line-height: 0.98;

  letter-spacing: -0.055em;

  font-weight: 800;
}


.mychess-brand-content h1 span {
  background:
    linear-gradient(
      110deg,
      #ffffff,
      #a78bfa,
      #7c3aed
    );

  -webkit-background-clip:
    text;

  background-clip:
    text;

  color: transparent;
}


.mychess-brand-content p {
  max-width: 470px;

  margin-top: 30px;

  font-size: 15px;

  line-height: 1.75;

  color:
    rgba(255,255,255,0.48);
}


.mychess-brand-footer {
  display: flex;
  align-items: center;

  gap: 12px;

  font-size: 9px;

  font-weight: 700;

  letter-spacing: 0.16em;

  color:
    rgba(255,255,255,0.32);
}


/* =========================================================
   AUTH PANEL
   ========================================================= */

.mychess-auth-panel {
  display: flex;
  flex-direction: column;

  justify-content: center;

  padding:
    55px
    clamp(
      35px,
      5vw,
      75px
    );

  background:
    rgba(7,6,11,0.45);
}


.mychess-auth-header {
  margin-bottom: 30px;
}


.mychess-auth-header h2 {
  margin: 0;

  font-size: 32px;

  line-height: 1.1;

  letter-spacing: -0.035em;
}


.mychess-auth-header p {
  margin:
    10px
    0
    0;

  font-size: 13px;

  line-height: 1.6;

