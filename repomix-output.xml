  background:
    rgba(255,255,255,0.025);
}


.mychess-secondary-button {
  width: 100%;

  height: 46px;

  margin-top: 16px;

  border:
    1px solid
    rgba(255,255,255,0.09);

  border-radius: 10px;

  color:
    rgba(255,255,255,0.58);

  background:
    rgba(255,255,255,0.025);

  font-size: 11px;

  font-weight: 700;

  transition:
    0.2s ease;
}


.mychess-secondary-button:hover {
  color: #ffffff;

  border-color:
    rgba(255,255,255,0.16);

  background:
    rgba(255,255,255,0.05);
}


/* =========================================================
   LOADING
   ========================================================= */

.mychess-auth-loading {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;
  align-items: center;

  text-align: center;
}


.mychess-auth-loading
.mychess-logo-mark {
  animation:
    mychess-pulse
    1.5s
    ease-in-out
    infinite;
}


.mychess-loading-title {
  margin-top: 18px;

  font-size: 20px;

  font-weight: 800;

  letter-spacing: 0.2em;
}


.mychess-loading-text {
  margin-top: 8px;

  font-size: 11px;

  color:
    rgba(255,255,255,0.32);
}


@keyframes mychess-pulse {
  0%,
  100% {
    transform:
      scale(1);

    box-shadow:
      0 10px 35px
      rgba(124,58,237,0.25);
  }

  50% {
    transform:
      scale(1.06);

    box-shadow:
      0 15px 50px
      rgba(124,58,237,0.45);
  }
}


