}

/* ============================================================
   GLOW BUTTON (FOR CTA BUTTONS)
   ============================================================ */

@keyframes spinBorder {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.next-gen-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16px 40px;
  border-radius: 14px;
