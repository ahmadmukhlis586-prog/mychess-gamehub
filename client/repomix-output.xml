/* =========================================================
   SHOP OVERLAY (WRAPPER)
   ========================================================= */
.shop-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 999999;
  background: rgba(9, 5, 20, 0.95);
  backdrop-filter: blur(16px);
  overflow-y: auto;
  display: flex;
  justify-content: center;
  padding: 20px;
  animation: shopFadeIn 0.3s ease;
}

@keyframes shopFadeIn {
  from { opacity: 0; transform: scale(0.98); }
  to { opacity: 1; transform: scale(1); }
}

.shop-overlay::-webkit-scrollbar {
  width: 6px;
}

.shop-overlay::-webkit-scrollbar-track {
  background: transparent;
}

.shop-overlay::-webkit-scrollbar-thumb {
  background: rgba(168, 85, 247, 0.3);
  border-radius: 10px;
}

.shop-overlay::-webkit-scrollbar-thumb:hover {
  background: rgba(168, 85, 247, 0.5);
}

/* =========================================================
   SHOP CLOSE BUTTON
   ========================================================= */
.shop-close-btn {
  position: absolute;
  top: 24px;
  right: 24px;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.03);
  color: #9ca3af;
  font-size: 24px;
  cursor: pointer;
  transition: all 0.3s ease;
  display: grid;
  place-items: center;
}

.shop-close-btn:hover {
  background: rgba(168, 85, 247, 0.15);
  border-color: rgba(168, 85, 247, 0.3);
  color: #ffffff;
  transform: rotate(90deg);
}

/* =========================================================
   SHOP PAGE CONTENT
   ========================================================= */
.shop-page {
  padding: 50px 30px 30px;
  max-width: 1200px;
  width: 100%;
  margin: 0 auto;
  color: #ffffff;
}

.shop-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 30px;
