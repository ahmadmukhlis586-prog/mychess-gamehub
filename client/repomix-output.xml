.game-history-body strong { color: #ffffff; font-weight: 700; }

/* ============================================================
   INVENTORY PAGE STYLES
   ============================================================ */

.inventory-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 999999; background: rgba(9, 5, 20, 0.98); backdrop-filter: blur(16px); overflow-y: auto; padding: 30px; }
