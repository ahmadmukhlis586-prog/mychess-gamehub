  overflow-x: hidden;
}

.floating-bg { display: block !important; opacity: 1 !important; z-index: 0 !important; }
.circle-node { display: block !important; visibility: visible !important; opacity: 1 !important; }

/* ============================================================
   PREMIUM MINIMALIST MUSIC ORB (Black & Purple Gradient)
============================================================ */

.music-float-btn {
  position: fixed;
  bottom: 25px;
  right: 25px;
  z-index: 9999;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  border: 2px solid rgba(168, 85, 247, 0.4);
  background: linear-gradient(145deg, rgba(10, 5, 20, 0.95) 0%, rgba(30, 15, 60, 0.95) 50%, rgba(85, 25, 180, 0.9) 100%);
  color: #c4b5fd;
  font-size: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 
    0 8px 25px rgba(0, 0, 0, 0.6), 
    0 0 15px rgba(168, 85, 247, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.music-float-btn:hover {
  transform: scale(1.1) translateY(-3px);
  border-color: rgba(168, 85, 247, 0.8);
  color: #ffffff;
  box-shadow: 
    0 12px 35px rgba(0, 0, 0, 0.7), 
    0 0 30px rgba(168, 85, 247, 0.6),
    inset 0 1px 0 rgba(255, 255, 255, 0.15);
}

.music-float-btn:active {
  transform: scale(0.95);
}

.music-float-btn.paused {
  background: linear-gradient(145deg, rgba(10, 5, 20, 0.95) 0%, rgba(20, 10, 35, 0.95) 100%);
  border-color: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.6);
  opacity: 0.8;
}

/* ============================================================
   GAME HISTORY PAGE STYLES
   ============================================================ */

.game-history-list { display: flex; flex-direction: column; gap: 15px; margin-top: 20px; }
.game-history-card { background: rgba(15, 10, 28, 0.85); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 16px; padding: 20px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3); transition: all 0.3s ease; }
.game-history-card:hover { border-color: rgba(168, 85, 247, 0.4); transform: translateY(-2px); }
.game-history-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
.game-date { font-size: 14px; font-weight: 600; color: #c4b5fd; }
.game-room { font-size: 12px; color: rgba(255, 255, 255, 0.45); margin-left: 12px; }
.game-result { font-size: 12px; font-weight: 800; padding: 5px 12px; border-radius: 20px; background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }
