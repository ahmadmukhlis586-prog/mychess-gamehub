  .mychess-mobile-logo { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; margin-bottom: 18px; border-radius: 12px; font-size: 23px; background: linear-gradient(145deg, #8b5cf6, #4c1d95); }
