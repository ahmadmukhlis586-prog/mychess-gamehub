.inventory-item { background: rgba(15, 10, 28, 0.8); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 16px; padding: 20px; text-align: center; transition: all 0.3s ease; }
.inventory-item:hover { border-color: rgba(168, 85, 247, 0.4); transform: translateY(-3px); }
.inventory-item.equipped { border-color: rgba(52, 211, 153, 0.4); background: rgba(52, 211, 153, 0.05); }

/* ============================================================
   LIVE PIECE PREVIEW STYLES
   ============================================================ */

.inventory-preview-section { background: rgba(15, 10, 28, 0.7); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 16px; padding: 25px; margin-bottom: 30px; text-align: center; }
.preview-title { font-size: 22px; font-weight: 800; color: #ffffff; margin-bottom: 5px; }
