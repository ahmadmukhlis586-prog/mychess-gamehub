.preview-board { background: linear-gradient(135deg, rgba(30, 20, 50, 0.8), rgba(10, 5, 20, 0.9)); border: 2px solid rgba(255, 255, 255, 0.1); border-radius: 12px; padding: 20px; display: flex; flex-direction: column; align-items: center; gap: 10px; max-width: 600px; margin: 0 auto; }
