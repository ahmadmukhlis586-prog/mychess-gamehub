/* ============================================================
   GAME ACTION BUTTONS (Create Lobby, Join Game & Chess Tips)
============================================================ */
.mychess-game-action {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14px;
  padding: 18px;
  min-height: 105px;
  background: rgba(15, 10, 28, 0.6);
  border: none;
  border-radius: 17px;
  color: #ffffff;
  cursor: pointer;
  overflow: hidden;
  z-index: 10; /* ✅ Ensures the button sits on top and receives clicks */
  pointer-events: auto; /* ✅ Ensures clicks are registered */
}

.mychess-game-action::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(from 0deg, #ff0080, #ff8c00, #40e0d0, #8a2be2, #ff0080);
  opacity: 0;
  transition: opacity 0.4s ease;
  animation: spinBorder 3s linear infinite;
  z-index: -1;
  pointer-events: none;
}

.mychess-game-action::after {
  content: '';
  position: absolute;
  inset: 2px;
  background: rgba(15, 10, 28, 0.95);
  border-radius: 15px;
  z-index: -1;
  pointer-events: none;
}

.mychess-game-action:hover::before { opacity: 1; }
.mychess-game-action:hover::after { background: rgba(25, 18, 45, 0.95); }
.mychess-game-action:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(168, 85, 247, 0.2);
}

.mychess-game-action > * {
  position: relative;
  z-index: 2;
  pointer-events: none;
}

.mychess-home-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 35px; }

.mychess-action-icon { width: 42px; height: 42px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border-radius: 12px; font-size: 21px; color: #c4b5fd; background: rgba(124, 58, 237, 0.13); border: 1px solid rgba(139, 92, 246, 0.14); }
.mychess-action-content { min-width: 0; display: flex; flex-direction: column; }
.mychess-action-content strong { font-size: 13px; font-weight: 800; }
.mychess-action-content span { margin-top: 4px; font-size: 9px; line-height: 1.4; color: rgba(255, 255, 255, 0.3); }
.mychess-action-arrow { margin-left: auto; font-size: 18px; color: rgba(255, 255, 255, 0.25); }

/* ✅ FULL WIDTH CHESS TIPS BUTTON */
.mychess-chess-tips-btn {
  grid-column: 1 / -1;
  position: relative;
  width: 100%;
  min-height: 105px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px;
  text-align: left;
  border: none;
  border-radius: 17px;
  color: #ffffff;
  background: rgba(15, 10, 28, 0.6);
  cursor: pointer;
  overflow: hidden;
  z-index: 10;
  pointer-events: auto;
}

.mychess-chess-tips-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(from 0deg, #ff0080, #ff8c00, #40e0d0, #8a2be2, #ff0080);
  opacity: 0;
  transition: opacity 0.4s ease;
  animation: spinBorder 3s linear infinite;
  z-index: -1;
  pointer-events: none;
}

.mychess-chess-tips-btn::after {
  content: '';
  position: absolute;
  inset: 2px;
  background: #0f0a1c;
  border-radius: 15px;
  z-index: -1;
  pointer-events: none;
}

.mychess-chess-tips-btn:hover::before { opacity: 1; }
.mychess-chess-tips-btn:hover::after { background: #160f29; }
.mychess-chess-tips-btn:hover { transform: translateY(-2px); box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25); }
.mychess-chess-tips-btn > * { position: relative; z-index: 2; pointer-events: none; }

.mychess-home-footer { display: flex; justify-content: center; flex-wrap: wrap; gap: 9px; margin-top: 42px; font-size: 8px; font-weight: 700; letter-spacing: 0.12em; color: rgba(255, 255, 255, 0.2); }

/* ============================================================
   MODAL STYLES
   ============================================================ */

.mychess-modal-backdrop { position: fixed; z-index: 100; inset: 0; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(12px); }
.mychess-modal { position: relative; width: min(430px, 100%); padding: 42px; text-align: center; border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 24px; background: linear-gradient(145deg, rgba(18, 15, 27, 0.98), rgba(9, 8, 13, 0.98)); box-shadow: 0 35px 100px rgba(0, 0, 0, 0.6); }
.mychess-modal-close { position: absolute; top: 16px; right: 17px; width: 30px; height: 30px; border: 0; border-radius: 8px; color: rgba(255, 255, 255, 0.35); background: rgba(255, 255, 255, 0.035); font-size: 20px; line-height: 1; transition: 0.2s ease; }
.mychess-modal-close:hover { color: #ffffff; background: rgba(255, 255, 255, 0.08); }
.mychess-modal-icon { width: 50px; height: 50px; margin: 0 auto 18px; display: flex; align-items: center; justify-content: center; border-radius: 15px; font-size: 24px; color: #ffffff; background: linear-gradient(145deg, #8b5cf6, #4c1d95); box-shadow: 0 12px 35px rgba(124, 58, 237, 0.25); }
.mychess-modal-eyebrow { font-size: 8px; font-weight: 800; letter-spacing: 0.22em; color: #a78bfa; }
.mychess-modal h2 { margin: 9px 0 0; font-size: 29px; letter-spacing: -0.04em; }
.mychess-modal > p { margin: 10px auto 25px; max-width: 310px; font-size: 11px; line-height: 1.65; color: rgba(255, 255, 255, 0.34); }

.mychess-room-input { margin-bottom: 15px; }
.mychess-room-input input { width: 100%; height: 65px; outline: none; text-align: center; letter-spacing: 0.35em; font-size: 27px; font-weight: 800; color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 13px; background: rgba(255, 255, 255, 0.035); transition: 0.2s ease; }
.mychess-room-input input:focus { border-color: rgba(139, 92, 246, 0.7); background: rgba(124, 58, 237, 0.06); box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.09); }

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 850px) {
  .mychess-auth-page { padding: 18px; }
