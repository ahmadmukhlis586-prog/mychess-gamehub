/* ============================================================
   FORCED HOME PAGE OVERRIDES (MUST BE AT BOTTOM)
   ============================================================ */

.mychess-home-page, .mychess-auth-page {
  background: radial-gradient(circle at 15% 15%, rgba(124, 58, 237, 0.16), transparent 32%),
    radial-gradient(circle at 85% 85%, rgba(91, 33, 182, 0.12), transparent 34%),
