  overflow: hidden;
  z-index: 1;
  background: transparent;
  border: none;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.next-gen-btn::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: conic-gradient(from 0deg, #ff0080, #ff8c00, #40e0d0, #8a2be2, #ff0080);
