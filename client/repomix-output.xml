.preview-piece { font-size: 42px; line-height: 1; transition: all 0.3s ease; user-select: none; }
.preview-piece:hover { transform: scale(1.2); }

/* ============================================================
   BACK TO DEFAULT BUTTON
   ============================================================ */

.reset-default-btn { position: absolute; top: 24px; right: 80px; padding: 10px 18px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.05); color: #ffffff; font-size: 12px; font-weight: 700; cursor: pointer; transition: all 0.3s ease; z-index: 10; }
.reset-default-btn:hover:not(:disabled) { background: rgba(168, 85, 247, 0.2); border-color: rgba(168, 85, 247, 0.5); transform: translateY(-2px); box-shadow: 0 5px 15px rgba(168, 85, 247, 0.2); }
