# ============================================================
# MYCHESS DEPLOYMENT ENVIRONMENT VARIABLES (example)
# Copy this to .env for local dev, or set these as environment
# variables on your cloud host (Render / Neon).
# NEVER commit the real .env file (it's git-ignored).
# ============================================================

# --- Server ---
PORT=4000

# --- PostgreSQL (local defaults; replace with your Neon/Render DB) ---
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mychessgame_db
DB_PASSWORD=mychess123
DB_PORT=5432

# Optional: single connection string (preferred on Render/Neon)
# If set, it overrides the individual DB_* vars above.
# DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require
